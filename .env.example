# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# ---- Database ----
# Vercel's Neon integration sets this automatically.
# For local development without Neon, use an embedded database folder:
# DATABASE_URL=pglite://./.data/dev-db
# DATABASE_URL=

# ---- Sign-in (Google) ----
# Sign-in, Projects & History and Team & access turn on only when ALL of
# DATABASE_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set.
# Generate a secret with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public URL of the app (defaults to the Vercel production URL)
# BETTER_AUTH_URL=https://seo-studio-weld.vercel.app

# ---- Access ----
# Always admins (comma-separated). Can't be locked out from inside the app.
# ADMIN_EMAILS=you@company.com
# Emails at these domains are approved automatically as members (optional).
# AUTO_APPROVE_DOMAINS=company.com

# ---- Demo mode ----
# Tools usable without signing in; saved data & admin still require sign-in.
# PUBLIC_TOOLS=true

# ---- Optional extra lock: HTTP Basic Auth in front of everything ----
# SITE_USERNAME=team
# SITE_PASSWORD=

# ---- AI features (Claude API) ----
# Turns on AI Visibility. Without it AI buttons stay visible but disabled. Server-only, never exposed.
# ANTHROPIC_API_KEY=
# Spending limits in USD (defaults: 5 per person per day, 50 per month for the whole app).
# AI_DAILY_USER_LIMIT_USD=5
# AI_MONTHLY_BUDGET_USD=50
# Vercel Cron sends this as a Bearer token to /api/cron/visibility (weekly scheduled runs).
# CRON_SECRET=

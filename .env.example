# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# ---- Database ----
# Vercel's Neon integration sets this automatically.
# For local development without Neon, use an embedded database folder:
# DATABASE_URL=pglite://./.data/dev-db
# DATABASE_URL=

# ---- Accounts (email + password) ----
# Sign-in, per-person Projects & History and Team & access turn on when DATABASE_URL and
# BETTER_AUTH_SECRET are both set. Generate a secret with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=
# Optional: also offer "Continue with Google" (needs a published Google OAuth client).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public URL of the app. Leave UNSET on Vercel: it defaults to the production domain, and all of the
# project's Vercel addresses are trusted automatically. Set it only for a custom domain.
# BETTER_AUTH_URL=https://seo-studio-weld.vercel.app
# Extra addresses allowed to sign in from (comma-separated), e.g. a second custom domain.
# TRUSTED_ORIGINS=

# ---- Email (password-reset links) ----
# Gmail address + App password (Google Account → Security → App passwords). Without these,
# "Forgot password?" uses admin-approved resets instead.
# SMTP_USER=yourapp@gmail.com
# SMTP_PASSWORD=
# Optional: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  EMAIL_FROM="SEO & GEO Studio <yourapp@gmail.com>"

# ---- Access ----
# Who may create accounts (approved straight away). Default: uw.edu. "*" = anyone (then pending).
# SIGNUP_DOMAINS=uw.edu
# How the UI names them ("your UW email"); the domain itself is never shown.
# SIGNUP_LABEL=UW
# Always admins (comma-separated). Can't be locked out from inside the app.
# ADMIN_EMAILS=you@company.com
# Approved members as soon as they create an account (e.g. testers). Admins can still disable them.
# APPROVED_EMAILS=tester@school.edu
# Google sign-ins at these domains are approved automatically (optional). Email + password
# sign-ups always wait for approval, because the address isn't verified.
# AUTO_APPROVE_DOMAINS=company.com

# ---- Free tools ----
# Free (non-AI) tools are public by default. Set false to require sign-in for them too.
# Premium (AI) tools, saved data and admin always require an approved account.
# PUBLIC_TOOLS=false

# ---- Optional extra lock: HTTP Basic Auth in front of everything ----
# SITE_USERNAME=team
# SITE_PASSWORD=

# ---- AI features (Claude API) ----
# Turns on AI Visibility. Without it AI buttons stay visible but disabled. Server-only, never exposed.
# ANTHROPIC_API_KEY=
# Spending limits in USD (defaults: 2 per person per day, 10 per month for the whole app,
# sized for the $10 starter credits). Raise them when the budget grows.
# AI_DAILY_USER_LIMIT_USD=2
# AI_MONTHLY_BUDGET_USD=10
# Model for AI features: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5.
# Use a cheaper model for testing/preview; unsupported values fall back to the default.
# AI_MODEL=claude-opus-5-5
# Web searches allowed per AI Visibility question (1-5, default 2). Fewer = cheaper.
# AI_WEB_SEARCH_MAX_USES=2
# Vercel Cron sends this as a Bearer token to /api/cron/visibility (weekly scheduled runs).
# CRON_SECRET=

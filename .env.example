# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project → Settings → Environment Variables.

# ---- Database ----
# Vercel's Neon integration sets this automatically.
# For local development without Neon, use an embedded database folder:
# DATABASE_URL=pglite://./.data/dev-db
# DATABASE_URL=

# ---- Sign-in (Google) ----
# Sign-in, Projects & History and Team & access turn on only when ALL of
# DATABASE_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set.
# Generate a secret with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public URL of the app (defaults to the Vercel production URL)
# BETTER_AUTH_URL=https://seo-studio-weld.vercel.app

# ---- Access ----
# Always admins (comma-separated). Can't be locked out from inside the app.
# ADMIN_EMAILS=you@company.com
# Emails at these domains are approved automatically as members (optional).
# AUTO_APPROVE_DOMAINS=company.com

# ---- Optional extra lock: HTTP Basic Auth in front of everything ----
# SITE_USERNAME=team
# SITE_PASSWORD=

# ---- Phase 2: AI copywriting (optional) ----
# ANTHROPIC_API_KEY=
